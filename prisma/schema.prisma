// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Users {
  id            Int            @id @default(autoincrement())
  name          String
  email         String         @unique
  password      String
  bio           String?
  avatar        String?
  created_at    DateTime       @default(now())
  threads       Threads[]
  comments      Comment[]
  notifications Notification[]
  memberships   Membership[]
  followers Following[] @relation("following")
  following Following[] @relation("follower")
  reaction EntryReaction[]
}

model Threads {
  id          Int          @id @default(autoincrement())
  user        Users        @relation(fields: [userId], references: [id])
  userId      Int
  title       String
  description String
  visibility  Boolean      @default(false)
  created_at  DateTime     @default(now())
  entries     Entry[]
  invites     Invite[]
  memberships Membership[]
}

model Entry {
  id           Int       @id @default(autoincrement())
  title        String
  body         String
  entry_date   DateTime  @default(now())
  thread       Threads   @relation(fields: [threadId], references: [id])
  threadId     Int
  location     String?
  is_published Boolean   @default(false)
  created_at   DateTime  @default(now())
  media        Media[]
  comments     Comment[]
  tags EntryTag[]
  reaction EntryReaction[]
}

model Media {
  id      Int    @id @default(autoincrement())
  entry   Entry  @relation(fields: [entryId], references: [id])
  entryId Int
  url     String
  type    String
}

model Tag {
  id      Int     @id @default(autoincrement())
  name    String
  is_auto Boolean @default(false)
  entries EntryTag[]
}

model Comment {
  id         Int      @id @default(autoincrement())
  author     Users    @relation(fields: [userId], references: [id])
  userId     Int
  entry      Entry    @relation(fields: [entryId], references: [id])
  entryId    Int
  body       String
  created_at DateTime @default(now())
}

model Notification {
  id         Int      @id @default(autoincrement())
  user       Users    @relation(fields: [userId], references: [id])
  userId     Int
  type       Reaction
  is_read    Boolean  @default(false)  // fixed: default should be unread
  created_at DateTime @default(now())
}

model Invite {
  id        Int      @id @default(autoincrement())
  thread    Threads  @relation(fields: [threadsId], references: [id])
  threadsId Int
  email     String
  status    Stat     @default(PENDING)
  expires_at DateTime
}

model Membership {
  thread    Threads  @relation(fields: [threadId], references: [id])
  threadId  Int
  user      Users    @relation(fields: [userId], references: [id])
  userId    Int
  role      Roles    @default(OBSERVER)
  joined_at DateTime @default(now())

  @@id([threadId, userId])   // composite primary key
}


model Following{
  follower Users @relation("follower", fields:[followerId],references:[id])
  followerId Int
  following Users @relation("following", fields:[followingId],references:[id])
  followingId Int
  created_at DateTime @default(now())

  @@id([followerId,followingId])
  
}


model EntryReaction{
  id Int @id @default(autoincrement())
  user Users @relation(fields:[userId],references:[id])
  userId Int
  entry Entry @relation(fields:[entryId],references:[id])
  entryId Int
  type ReactionType
  created_at DateTime @default(now())

  @@unique([userId,entryId]) 
}

model EntryTag{
  entry Entry @relation(fields:[entryId],references:[id])
  entryId Int
  tag Tag @relation(fields:[tagId],references:[id])
  tagId Int

  @@id([entryId,tagId])
}
enum Reaction {
  INVITE
  COMMENT
  REACT
}

enum Stat {
  ACCEPTED
  PENDING
  DECLINE
}

enum Roles {
  ADMIN
  COLLABORATOR
  OBSERVER
}

enum ReactionType{
  LIKE
  HEART
  DISLIKE
  SHOCK
}